# Cadena de conexión de PostgreSQL. En local, copia este archivo a .env.local.
# En Vercel, defínela en Settings → Environment Variables.
DATABASE_URL=postgres://usuario:clave@host:5432/base?sslmode=require

# Clave del staff. Abrir /leaderboard?staff=<clave> muestra el botón de
# WhatsApp de cada ganador. Sin ella, el ranking no expone teléfonos.
CLAVE_STAFF=

# Correo con el resultado y el QR al terminar cada partida (vía Resend).
# Sin estas dos, no se envía nada. El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
CORREO_REMITENTE=Joalca Games <juegos@tudominio.com>
